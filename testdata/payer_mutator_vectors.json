      "changed": true,
      "want": "{}"
    },
    {
      "name": "provider_escaped_key",
      "body": "{\"prov\\u0069der\":{\"sort\":\"price\"},\"model\":\"m\"}",
      "changed": true,
      "want": "{\"model\":\"m\"}"
    },
    {
      "name": "provider_nested_not_top_level",
      "body": "{\"metadata\":{\"provider\":\"x\"},\"model\":\"m\"}",
      "changed": false,
      "want": "{\"metadata\":{\"provider\":\"x\"},\"model\":\"m\"}"
    },
    {
      "name": "provider_whitespace",
      "body": "{\n  \"model\" : \"m\" ,\n  \"provider\" : { \"only\" : [ \"x\" ] }\n}\n",
      "changed": true,
      "want": "{\"model\":\"m\"}"
    },
    {
      "name": "tools_null_whitespace",
      "body": "{\"tools\" : null ,\"tool_choice\":\"auto\" , \"n\" : 1\t}",
      "changed": false,
      "want": "{\"tools\" : null ,\"tool_choice\":\"auto\" , \"n\" : 1\t}"
    },
    {
      "name": "leading_bom",
