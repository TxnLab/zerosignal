{
  "version": 1,
  "comment": "Cross-impl vectors for the payer's pre-seal mutators. They pin which bodies change and what the result means, not its bytes: compare `want` by value. Generated by proto/go/inject/payer_mutator_vectors_test.go; regenerate with `cd proto/go \u0026\u0026 go test ./inject -run TestPayerMutatorVectors -update`.",
  "max_output_fields": [
    "max_completion_tokens",
    "max_tokens",
    "max_output_tokens"
  ],
  "drop_routing_preferences": [
    {
      "name": "empty_body",
      "body": "",
      "changed": false,
      "want": ""
    },
    {
      "name": "not_json",
      "body": "{\"model\":",
      "changed": false,
      "want": "{\"model\":"
    },
    {
      "name": "top_level_array",
      "body": "[{\"provider\":{}}]",
      "changed": false,
      "want": "[{\"provider\":{}}]"
    },
    {
