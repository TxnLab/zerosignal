      "changed": false,
      "want": "{\"model\":\"m\",\"messages\":[]}"
    },
    {
      "name": "provider_object",
      "body": "{\"model\":\"m\",\"provider\":{\"order\":[\"a\"],\"allow_fallbacks\":false},\"stream\":true}",
      "changed": true,
      "want": "{\"model\":\"m\",\"stream\":true}"
    },
    {
      "name": "provider_null",
      "body": "{\"provider\":null,\"model\":\"m\"}",
      "changed": true,
      "want": "{\"model\":\"m\"}"
    },
    {
