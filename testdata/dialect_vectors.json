    {
      "url": "://api.x.ai",
      "want": "generic",
      "why": "does not parse"
    },
    {
      "url": "//api.x.ai/v1",
      "want": "generic",
      "why": "scheme-relative: url.Parse finds a host, WHATWG URL refuses it"
    },
    {
      "url": "https:api.x.ai/v1",
      "want": "generic",
      "why": "opaque: no authority"
    },
    {
      "url": "https:///api.x.ai/v1",
      "want": "generic",
      "why": "empty authority"
    },
    {
      "url": "https://api.x.ai\\@attacker.example/v1",
      "want": "generic",
      "why": "WHATWG reads the backslash as a path separator"
    },
    {
      "url": "https://attacker.example\\.api.x.ai/v1",
      "want": "generic"
    },
    {
      "url": "https://api%2ex%2eai/v1",
      "want": "generic",
      "why": "percent-escaped host: url.Parse errors, WHATWG decodes it to api.x.ai — refused"
    },
    {
      "url": "https://api.x.ai/v1%zz",
      "want": "generic",
      "why": "malformed escape in the path: url.Parse refuses it, so the TS side must too"
    },
    {
      "url": "https://api.x.ai/v1#%zz",
      "want": "generic",
      "why": "malformed escape in the fragment"
    },
    {
      "url": "https://api.x.ai/v1%",
      "want": "generic",
      "why": "a trailing bare %"
    },
    {
      "url": "https://api.x.ai/v1?a=%zz",
      "want": "generic",
      "why": "url.Parse keeps the query raw; refused anyway so one rule covers the string"
    },
    {
      "url": "https://api.x.ai/v1%2F",
      "want": "xai",
      "why": "a well-formed escape in the path is fine"
    },
    {
      "url": "https://api.x.ai/v1?a=%4z",
      "want": "generic",
      "why": "half-valid escape: BOTH characters after % must be hex"
    },
    {
      "url": "https://api.x.ai/v1#",
      "want": "generic",
      "why": "DEL counts as a control byte, and url.Parse misses it in the fragment"
    },
    {
      "url": "https://a_b.x.ai/v1",
      "want": "generic",
      "why": "underscore: url.Parse accepts it, the LDH subset does not"
    },
    {
      "url": "https://[::1]:8000/v1",
      "want": "generic",
      "why": "IPv6 literal"
    },
    {
      "url": "https://api.x.ai:abc/v1",
      "want": "generic",
      "why": "non-numeric port"
    },
    {
      "url": "https://api.x.ai:/v1",
      "want": "xai",
      "why": "empty port: both parsers take the host"
    },
    {
      "url": "https://xn--x-9ga.ai/v1",
      "want": "generic",
      "why": "punycode is plain LDH and is not x.ai"
    },
    {
      "url": "https://api.х.ai/v1",
      "want": "generic",
      "why": "Cyrillic U+0445: not LDH, refused before any IDNA mapping"
    },
    {
      "url": "\thttps://api.x.ai/v1\n",
      "want": "xai",
      "why": "ASCII whitespace around the URL is trimmed"
    },
    {
      "url": "﻿https://api.x.ai/v1",
      "want": "generic",
      "why": "U+FEFF: non-ASCII whitespace is not trimmed on either side"
    },
    {
      "url": " https://api.x.ai/v1",
      "want": "generic",
      "why": "U+00A0"
    },
    {
      "url": "https://api.x.ai/v1\u0001",
      "want": "generic",
      "why": "a control byte anywhere is refused on both sides"
    },
    {
      "url": "https://api.x.ai/v1#f\u0000",
      "want": "generic",
      "why": "url.Parse alone admits a control byte in the fragment; refused explicitly"
    },
    {
      "url": "https://api.x.ai/v1",
      "want": "generic"
    },
    {
      "url": "https://api.x.ai:443:1/v1",
      "want": "generic",
      "why": "two colons: not a host:port"
    },
    {
      "url": "https://attacker.example?@api.x.ai/v1",
      "want": "generic",
      "why": "the query ends the authority in both parsers"
    }
