    {
      "block_json": "{\"protocol\":\"aci/1\"}",
      "want": true,
      "why": "presence of a recognized protocol is the whole check; nothing else is verified here"
    },
    {
      "block_json": "",
      "want": false,
      "why": "absent"
    },
    {
      "block_json": "null",
      "want": false
    },
    {
      "block_json": "{}",
      "want": false,
      "why": "an empty block names no protocol, so it is unverifiable"
    },
    {
      "block_json": "{\"protocol\":\"aci/2\"}",
      "want": false,
      "why": "an unrecognized protocol MUST be treated as unverifiable"
    },
    {
      "block_json": "{\"protocol\":\"ACI/1\"}",
      "want": false,
      "why": "exact match"
    },
    {
      "block_json": "{\"Protocol\":\"aci/1\"}",
      "want": false,
      "why": "keys match exactly on both sides"
    },
    {
      "block_json": "{\"protocol\":1}",
      "want": false,
      "why": "Go fails the bundle decode; TypeScript reads a non-string"
    },
    {
      "block_json": "[]",
      "want": false,
      "why": "not an object: Go fails the bundle decode"
    },
    {
      "block_json": "true",
      "want": false
    },
    {
      "block_json": "\"aci/1\"",
      "want": false
    }
